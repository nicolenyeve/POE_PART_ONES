import java.io.FileWriter;
import java.io.IOException;
import java.util.Scanner;

public class MessageApp {

    private static int messageCount = 0;

    private static String generateMessageId() {
        return "MSG" + System.currentTimeMillis();
    }

    private static String generateMessageHash(String messageId,
                                              int count,
                                              String message) {

        String[] words = message.trim().split("\\s+");

        String first = words.length > 0 ? words[0] : "";
        String last = words.length > 1 ? words[words.length - 1] : first;

        return messageId.substring(0, 2) + ":" +
                count + ":" +
                first.toUpperCase() +
                last.toUpperCase();
    }

    public static void startChat() {

        Scanner scanner = new Scanner(System.in);

        while (true) {

            System.out.println("Quick chat");
            System.out.println("1 - Show the full report");
            System.out.println("2 - Send a message");
            System.out.println("3 - Quit");
            System.out.println("4 - Show recipients");
            System.out.println("5 - Display the longest message");
            System.out.println("6 - Search by message ID");
            System.out.println("7 - Search By Recipient");
            System.out.println("8 - Delete By Hash");

            System.out.print("Enter choice: ");

            int choice = scanner.nextInt();
            scanner.nextLine();

            switch (choice) {

                case 1:
                    Manager.displayFullReport();
                    break;

                case 2:

                    String recipient;

                    do {
                        System.out.print("Enter the recipient number (+27: ");
                        recipient = scanner.nextLine();

                    } while (!(recipient.startsWith("+27")
                            && recipient.length() == 12));

                    System.out.print("Enter message (250 characters max): ");
                    String message = scanner.nextLine();

                    if (message.length() > 250) {
                        System.out.println("ERROR!!!!!! Message exceeds 250 characters change it NOW!!!!.");
                        break;
                    }

                    String messageId = generateMessageId();

                    int currentMessageCount = ++messageCount;

                    String messageHash =
                            generateMessageHash(
                                    messageId,
                                    currentMessageCount,
                                    message
                            );

                    System.out.println("Message ID: " + messageId);
                    System.out.println("Message Hash: " + messageHash);

                    System.out.println("1 - Send message");
                    System.out.println("2 - Disregard message.");
                    System.out.println("3 - Store message for later");

                    int subChoice = scanner.nextInt();
                    scanner.nextLine();

                    switch (subChoice) {

                        case 1:

                            Manager.addMessage(
                                    messageId,
                                    recipient,
                                    message,
                                    messageHash
                            );

                            System.out.println("Message was sent successfully.");
                            break;

                        case 2:

                            System.out.println("Message is discarded.");
                            break;

                        case 3:

                            Manager.addMessage(
                                    messageId,
                                    recipient,
                                    message,
                                    messageHash
                            );

                            storeMessageToTextFile(
                                    messageId,
                                    recipient,
                                    message,
                                    messageHash
                            );

                            System.out.println("Message stored successfully.");
                            break;

                        default:
                            System.out.println("Invalid option.");
                    }

                    break;

                case 3:

                    System.out.println("Goodbye! See you later.");
                    scanner.close();
                    return;

                case 4:

                    Manager.displayRecipients();
                    break;

                case 5:

                    Manager.displayLongestMessage();
                    break;

                case 6:

                    System.out.print("Enter the message ID: ");
                    String id = scanner.nextLine();

                    Manager.searchByMessageId(id);
                    break;

                case 7:

                    System.out.print("Enter the recipients number: ");
                    String searchRecipient = scanner.nextLine();

                    Manager.searchMessagesByRecipient(searchRecipient);
                    break;

                case 8:

                    System.out.print("Enter the message hash: ");
                    String hash = scanner.nextLine();

                    Manager.deleteMessageByHash(hash);
                    break;

                default:
                    System.out.println("Invalid choice.");
            }
        }
    }

    private static void storeMessageToTextFile(
            String id,
            String recipient,
            String message,
            String hash) {

        try (FileWriter file =
                     new FileWriter("stored_message.txt", true)) {

            file.write("Message ID: " + id + "\n");
            file.write("Recipient: " + recipient + "\n");
            file.write("Message: " + message + "\n");
            file.write("Hash: " + hash + "\n");
            file.write("\n");

        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public static void main(String[] args) {
        startChat();
    }
}
